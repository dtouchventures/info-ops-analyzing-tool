{
  "name": "aivs",
  "version": "1.27.0",
  "private": true,
  "description": "AIVS \u2014 Information Verification and Evidence Assistant (KDF Information Operations pilot)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed:training": "node scripts/seed-training.js",
    "train:sentiment": "node scripts/train-sentiment.js",
    "seed:coverage-demo": "node scripts/seed-coverage-demo.js",
    "check:transcribe": "node scripts/check-transcribe.js",
    "check:investigate": "node scripts/check-investigate.js",
    "create-user": "node scripts/create-user.js",
    "reset-password": "node scripts/reset-password.js",
    "verify-audit": "node scripts/verify-audit.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e.mjs",
    "test:automatic:e2e": "node test/automatic-e2e.mjs",
    "report:preview": "node scripts/preview-assessment.js",
    "check:facebook": "node scripts/check-facebook.js",
    "meta:token": "node scripts/meta-token.js",
    "check:search": "node scripts/check-search.js"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/swa": "1.0.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.11.1",
    "exifr": "7.1.3",
    "express": "4.22.3",
    "multer": "2.4.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "sharp": "0.35.5",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "playwright": "1.56.0"
  }
}
