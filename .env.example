# AIVS configuration. Copy to .env and adjust. Never commit the real .env.
PORT=8080
# 127.0.0.1 = this computer only. Use 0.0.0.0 to serve a local network (put HTTPS in front first).
HOST=127.0.0.1
DATA_DIR=data
# Set true when served over HTTPS (adds Secure cookies and HSTS).
COOKIE_SECURE=false
# Set true when behind a reverse proxy (nginx, IIS) so client IPs are logged correctly.
TRUST_PROXY=false
SESSION_HOURS=10
MAX_UPLOAD_MB=200
# Separation of duties: keep false in operational use.
ALLOW_SELF_APPROVAL=false

# ---- Content from links (New investigation) and social media post lookup
# X, YouTube, TikTok and Telegram public embeds need no key. Facebook and Instagram need Meta credentials:
#  META_OEMBED_TOKEN      APPID|CLIENTTOKEN of a Meta app with the oEmbed Read feature: author and a possibly shortened text
#  FACEBOOK_ACCESS_TOKEN  (below, Mention Watch) also lets AIVS read the full text of posts on Pages the token may read
# YOUTUBE_API_KEY and X_BEARER_TOKEN (below) are used too when set. Keys stay on the server.
META_OEMBED_TOKEN=
# or: the Meta app's client token (App settings > Advanced > Client token), combined with META_APP_ID; the app needs the oEmbed Read feature
META_CLIENT_TOKEN=

# ---- Social media analysis: collecting public posts through official APIs (leave blank to keep a collector off)
# YouTube Data API v3 key (free, from Google Cloud). search.list is limited to 100 calls a day per project, in its own quota bucket
YOUTUBE_API_KEY=
# X API v2 bearer token (X developer app with pay-per-use credit; posts read are charged, about $0.005 each, checked October 2026)
X_BEARER_TOKEN=
COLLECT_MAX_ITEMS=500
COLLECT_TIMEOUT_MS=15000
# Facebook, Instagram and TikTok need approved research access (Meta Content Library, TikTok Research API): pending.
# News feeds used when a mention watchlist names none (space or comma separated)
RSS_FEEDS=

# ---- KDF Mention Watch (uses X_BEARER_TOKEN, YOUTUBE_API_KEY and news feeds above)
# Scheduled collection for active watchlists; false stops all collection
WATCH_ENABLED=true
WATCH_TICK_SECONDS=30
# X filtered stream: set true only when your X access includes it. Pay-per-use allows one connection, so no
# other application may use the same X project's stream.
WATCH_X_STREAM=false
# Minutes of backfill (0-5) requested after a short disconnection; 0 recovers gaps with recent search instead
WATCH_X_BACKFILL_MINUTES=0
# Stop reading X posts for the day after this many (search, stream and count refreshes together; resets 00:00 UTC)
WATCH_X_DAILY_POSTS=2000
WATCH_X_POSTS_PER_RUN=100
X_USD_PER_POST=0.005
# YouTube searches a day used by the watch (YouTube allows 100; resets at midnight Pacific Time)
WATCH_YOUTUBE_SEARCH_DAILY=90
# Refresh public counts of posts under watch every N minutes (0 = off); X lookups count toward the daily posts
WATCH_METRICS_REFRESH_MINUTES=60

# ---- Mention Watch: more platforms, each through its own official API (leave blank to keep a platform off)
# Reddit: an app registered and approved under Reddit's Data API terms (app-only OAuth; 100 queries a minute).
# REDDIT_USERNAME is the contact named in the User-Agent Reddit requires.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
# Bluesky: an app password (Settings > Privacy and security > App passwords), never the account's main password
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS=https://bsky.social
# Mastodon: servers whose public hashtag timelines to follow (no key), for example mastodon.social
MASTODON_INSTANCES=
# Threads: a token from a Meta app approved for threads_basic and threads_keyword_search
THREADS_ACCESS_TOKEN=
WATCH_THREADS_DAILY_QUERIES=1000
# Instagram hashtags: a professional account linked to a Facebook Page, app approved for Instagram Public Content Access
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_VERSION=v26.0
# Facebook: posts and public comments of named public Pages. Other organisations' Pages need a business-verified Meta
# app approved for Page Public Content Access; your own Pages need a Page access token. Facebook cannot be searched as a whole.
# Older name for the same token. Leave it empty: META_PAGE_ACCESS_TOKEN (below) is used by Live Monitoring, Verify Information
# and the watchlists alike. If both are set, Live Monitoring uses META_PAGE_ACCESS_TOKEN and the watchlists FACEBOOK_ACCESS_TOKEN.
FACEBOOK_ACCESS_TOKEN=
# Pages used when a watchlist names none (usernames or IDs, comma separated)
FACEBOOK_PAGES=
WATCH_FACEBOOK_COMMENT_POSTS=10
# TikTok Research API: only for researchers TikTok has approved (academic institutions in the U.S., EEA, UK, Canada,
# Switzerland and some EU non-profits). 1,000 requests a day.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
WATCH_TIKTOK_DAILY_REQUESTS=500
# Telegram: a bot from @BotFather, added by each channel's administrator. Only channels; groups and DMs are ignored.
TELEGRAM_BOT_TOKEN=
# Your own private channels the bot may read (numeric chat IDs, comma separated); public channels need no listing
TELEGRAM_OWN_CHANNELS=
# WhatsApp Business (Cloud API) webhook for messages sent to your own business number: https://<public address>/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Optional local AI for social media analysis (Ollama on this computer or an institution server)
# Never expose Ollama to the internet. Public addresses are refused unless OLLAMA_ALLOW_REMOTE=true.
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=60000
OLLAMA_BATCH_SIZE=20
OLLAMA_ALLOW_REMOTE=false

# ---- Backups (Administration -> Backups & retention). A daily backup is made automatically.
# Folder for backups (default: a "backups" folder next to the data folder). Copy it off the server regularly.
BACKUP_DIR=
BACKUP_KEEP=7
BACKUP_DISABLED=false
# Domain for deploy/docker-compose.yml (Caddy obtains the HTTPS certificate for it)
AIVS_DOMAIN=

# ---- Optional cloud AI (leave blank to keep AI off; all local features still work)
# AI_PROVIDER=anthropic          # anthropic | openai (any OpenAI-compatible endpoint)
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=                   # optional private or regional endpoint
# AI_TIMEOUT_MS=90000
# AI_MAX_IMAGES=6

# ---- Verify Information (link retrieval) and rate limits
# AIVS_ALLOW_PRIVATE_FETCH=false   # keep false: refuses links to private/local network addresses (SSRF protection)
# RATE_WINDOW_SECONDS=300
# RATE_LIMIT_GENERAL=1500          # requests per user per window
# RATE_LIMIT_HEAVY=60              # page retrievals, uploads, analyses, AI requests and imports per user per window

# ---- Evidence search (Phase 2). Leave empty to disable; AIVS then searches only its own records.
# Google Fact Check Tools API (published ClaimReview fact-checks). Free key from Google Cloud; terms apply.
GOOGLE_FACTCHECK_API_KEY=
# Brave Search API (web search and official-source search). Paid plans; the operator accepts Brave's terms.
BRAVE_SEARCH_API_KEY=
# Optional: estimated cost per Brave request in USD, for the usage log (default 0)
BRAVE_USD_PER_REQUEST=
SEARCH_TIMEOUT_MS=10000
# Free public indexes used by automatic investigations (claim keywords are sent to them). Set to false to switch off.
# SEARCH_GDELT=true
# SEARCH_WIKIPEDIA=true

# ---- Automatic investigations (Verify Information, one click)
# INVESTIGATE_TIMEOUT_S=900          # total time for one investigation
# INVESTIGATE_CONCURRENCY=2          # how many run at the same time
# INVESTIGATE_ALLOW_EXTERNAL_AI=false # keep false: only AI on your own network (Ollama) is used automatically
# INVESTIGATE_MAX_LINK_IMAGES=3      # images retrieved from a submitted link
# Optional AI description of images: a vision model installed on your own Ollama server (ollama pull qwen2.5vl:7b)
# INVESTIGATE_VISION_MODEL=
# INVESTIGATE_VISION_URL=            # defaults to the Ollama address in AI_BASE_URL / OLLAMA_URL
# Optional reverse-image search (Google Cloud Vision API, web detection). Images are sent to Google; each send is audited.
# GOOGLE_VISION_API_KEY=

# ---- AI (research assistant and AI assistance). Leave AI_PROVIDER empty to switch AI off.
# Free for testing: Google Gemini free tier (key from https://aistudio.google.com). Free-tier data may be used by Google:
# keep AI_TRAINING_ONLY=true so only training cases are ever sent.
#   AI_PROVIDER=gemini   AI_MODEL=<a Gemini model name shown in AI Studio>   AI_API_KEY=<your key>
# Free and private: Ollama on a capable computer (16 GB RAM recommended)  AI_PROVIDER=ollama  AI_MODEL=<model you pulled>
#   AI_BASE_URL=http://<that-computer>:11434   (no key needed)
# Paid: AI_PROVIDER=anthropic or openai, with AI_MODEL and AI_API_KEY.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TRAINING_ONLY=true
# Ollama on your own network (example for the organisation's Ubuntu server):
#   AI_PROVIDER=ollama
#   AI_BASE_URL=http://10.104.4.151:11434
#   AI_MODEL=qwen3:4b-instruct
# AI_TRAINING_ONLY applies only to services outside your network; Ollama on a private address may answer for real cases.
# Ollama context window in tokens (more = longer case material, more memory on the server); seconds to wait for an answer
AI_NUM_CTX=8192
AI_TIMEOUT_MS=240000
AI_HEALTH_TIMEOUT_MS=120000
# how long the health check waits for the Ollama server to list its models (a slow network or a busy start-up can delay it); tried twice
AI_CONNECT_TIMEOUT_MS=30000
AI_KEEP_ALIVE=30m
# A public Ollama address is refused unless this is true (only for a protected institution server)
AI_ALLOW_REMOTE=false

# ---- Speech-to-text for audio and video (AIVS transcription service, transcriber/ folder) ----
# Runs faster-whisper on a server on your network. Recordings go only there and are deleted after transcribing.
# set-transcribe.bat fills in the first two lines for you (it reads the token over SSH).
# TRANSCRIBE_URL=http://10.104.4.151:9000
# TRANSCRIBE_TOKEN=
# Largest recording AIVS will send (MB); the service also limits length (TRANSCRIBE_MAX_MINUTES on the server, default 120)
TRANSCRIBE_MAX_MB=500
# Minimum time AIVS waits for one transcription (ms); long recordings get up to 6 x their length on a CPU
TRANSCRIBE_TIMEOUT_MS=600000
# A public address is refused unless this is true (only for a protected institution server)
TRANSCRIBE_ALLOW_REMOTE=false

# ---------------------------------------------------------------- Live Facebook Monitoring (1.26)
# Every post of the authorised Facebook Pages is collected through the Meta Graph API, analysed, verified and reported
# automatically by the AIVS server (no browser needs to be open; the server must be running).
# META_PAGE_ACCESS_TOKEN: a Page access token for the Page(s) below. Keep it ONLY in this .env file on the server:
#   never in the browser, in GitHub, in screenshots or in chat. If a token was ever shown on screen, revoke it and
#   generate a new one (Meta Business Suite / Graph API Explorer → Page token), then restart AIVS.
META_PAGE_ACCESS_TOKEN=
# Page IDs to monitor, comma separated (for example the Praetorian Security and Intelligence Consultancy Page: 1229829760216382)
META_PAGE_IDS=
# Optional: lets AIVS read the token's expiry date and permissions from Meta (debug_token). Server side only.
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION (above) is shared with the other Meta connectors; v26.0 was tested.
# Automatic monitoring of the organisation's own Facebook Page is off (1.29). The token above is still used by Verify Information
# for posts of the authorised Page. Set to true only if the organisation decides to monitor its own Page again.
LIVE_FACEBOOK_MONITORING=false
# Keyword monitoring: AI analysis of discovered items (organisation's Ollama server), automatic evidence search and draft reports
MONITOR_AI_ITEMS_PER_MINUTE=4
MONITOR_AUTO_VERIFY_PER_HOUR=6
MONITOR_AUTO_REPORT_MIN_ITEMS=5
MONITOR_AUTO_REPORT_HOURS=6
LIVE_MONITOR_INTERVAL_MINUTES=5
LIVE_MONITOR_INITIAL_POSTS=25
LIVE_MONITOR_MAX_PAGES=5
LIVE_AUTO_ANALYSE=true
LIVE_ANALYSE_CONCURRENCY=1
LIVE_STORE_IMAGES=true
LIVE_ENGAGEMENT_REFRESH_MINUTES=30

# Report approval (1.32). Optional: the secret behind the verification codes printed on HOD-approved PDFs.
# If unset, AIVS generates one once and keeps it in the database. Set a long random value to control it yourself.
AIVS_REPORT_SECRET=
