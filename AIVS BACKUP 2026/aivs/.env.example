# AIVS configuration. Copy to .env and adjust. Never commit the real .env.
PORT=8080
# 127.0.0.1 = this computer only. Use 0.0.0.0 to serve a local network (put HTTPS in front first).
HOST=127.0.0.1
DATA_DIR=data
# Set true when served over HTTPS (adds Secure cookies and HSTS).
COOKIE_SECURE=false
# Set true when behind a reverse proxy (nginx, IIS) so client IPs are logged correctly.
TRUST_PROXY=false
SESSION_HOURS=10
MAX_UPLOAD_MB=200
# Separation of duties: keep false in operational use.
ALLOW_SELF_APPROVAL=false

# ---- Optional cloud AI (leave blank to keep AI off; all local features still work)
# AI_PROVIDER=anthropic          # anthropic | openai (any OpenAI-compatible endpoint)
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=                   # optional private or regional endpoint
# AI_TIMEOUT_MS=90000
# AI_MAX_IMAGES=6

# ---- Verify Information (link retrieval) and rate limits
# AIVS_ALLOW_PRIVATE_FETCH=false   # keep false: refuses links to private/local network addresses (SSRF protection)
# RATE_WINDOW_SECONDS=300
# RATE_LIMIT_GENERAL=1500          # requests per user per window
# RATE_LIMIT_HEAVY=60              # page retrievals, uploads, analyses, AI requests and imports per user per window

# ---- Evidence search (Phase 2). Leave empty to disable; AIVS then searches only its own records.
# Google Fact Check Tools API (published ClaimReview fact-checks). Free key from Google Cloud; terms apply.
GOOGLE_FACTCHECK_API_KEY=
# Brave Search API (web search and official-source search). Paid plans; the operator accepts Brave's terms.
BRAVE_SEARCH_API_KEY=
# Optional: estimated cost per Brave request in USD, for the usage log (default 0)
BRAVE_USD_PER_REQUEST=
SEARCH_TIMEOUT_MS=10000

# ---- AI (research assistant and AI assistance). Leave AI_PROVIDER empty to switch AI off.
# Free for testing: Google Gemini free tier (key from https://aistudio.google.com). Free-tier data may be used by Google:
# keep AI_TRAINING_ONLY=true so only training cases are ever sent.
#   AI_PROVIDER=gemini   AI_MODEL=<a Gemini model name shown in AI Studio>   AI_API_KEY=<your key>
# Free and private: Ollama on a capable computer (16 GB RAM recommended)  AI_PROVIDER=ollama  AI_MODEL=<model you pulled>
#   AI_BASE_URL=http://<that-computer>:11434   (no key needed)
# Paid: AI_PROVIDER=anthropic or openai, with AI_MODEL and AI_API_KEY.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TRAINING_ONLY=true
